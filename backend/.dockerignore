# Exclude local environment (contains secrets)
.env
.env.local
*.local

# Exclude virtual environment (heavy, not needed for builds)
.venv/

# Exclude Python cache (large)
__pycache__/
*.py[cod]
*.pyo

# Exclude test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Exclude build artifacts
dist/
build/
