# ── LiveKit ────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=this-is-a-minimum-32-char-development-secret!!

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finance_knowledge

# ── PostgreSQL ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/advisor

# ── LLM ───────────────────────────────────────────────
LLM_PROVIDER=openai       # openai | ollama
OPENAI_API_KEY=            # <your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ── STT (Speech-to-Text) ─────────────────────────────
STT_PROVIDER=deepgram      # deepgram | whisper
DEEPGRAM_API_KEY=          # <your-deepgram-api-key>

# ── TTS (Text-to-Speech) ─────────────────────────────
TTS_PROVIDER=cartesia      # cartesia | edge-tts | elevenlabs
CARTESIA_API_KEY=          # <your-cartesia-api-key>
CARTESIA_VOICE_ID=6f6a6c6c-6b6a-4e6f-8e6a-6c6c6b6a4e6f

# ── Embedding ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ── App ───────────────────────────────────────────────
LOG_LEVEL=DEBUG
DEBUG=true
